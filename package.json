{
  "name": "pixel-rts",
  "productName": "Pixel RTS",
  "version": "0.9.5",
  "description": "Pixel RTS — yaşayan Avrupa seferi: şehir üretimi, konsey, diplomasi",
  "main": "electron/main.js",
  "scripts": {
    "test": "node tests/story-dialogue-corpus.test.js && node tests/story-dialogue-move.test.js && node tests/story-dialogue-hard-assertion-audit.test.js && node tests/story-discourse-state.test.js && node tests/story-conversation-domains.test.js && node tests/story-conversation-context.test.js && node tests/story-conversation-player-regressions.test.js && node tests/story-dialogue-adversarial-player-manifest.test.js && node tests/story-llm-context-limit.test.js && node tools/story-test-parallel.js",
    "test:story": "node tools/story-test-parallel.js",
    "test:story:plan": "node tools/story-test-parallel.js --plan",
    "test:story:serial": "node --max-old-space-size=8192 --expose-gc tests/story-world.test.js",
    "test:story:profile": "node tools/story-test-profile.js",
    "test:story:soak": "node tests/story-soak.test.js",
    "story:baseline": "node tools/story-baseline.js",
    "story:report": "node tools/story-baseline.js",
    "story:compare": "node tools/story-compare.js",
    "story:ab": "node tools/story-ab.js",
    "story:llm-bench": "node tools/story-llm-benchmark.js",
    "story:llm-gate": "node tools/story-llm-benchmark.js --gate",
    "story:arbiter-bench": "node tools/story-character-arbiter-benchmark.js",
    "story:arbiter-gate": "node tools/story-character-arbiter-benchmark.js --gate",
    "story:dialogue-blind": "node tools/story-dialogue-blind-eval.js",
    "story:dialogue-corpus": "node tools/story-dialogue-corpus.js",
    "story:dialogue-corpus-test": "node tests/story-dialogue-corpus.test.js",
    "story:dialogue-move-test": "node tests/story-dialogue-move.test.js",
    "story:dialogue-hard-audit": "node tools/story-dialogue-hard-assertion-audit.js",
    "story:dialogue-replay": "node tools/story-dialogue-current-replay.js",
    "story:discourse-state-test": "node tests/story-discourse-state.test.js",
    "story:conversation-domains-test": "node tests/story-conversation-domains.test.js",
    "story:conversation-context-test": "node tests/story-conversation-context.test.js",
    "story:conversation-player-regressions": "node tests/story-conversation-player-regressions.test.js",
    "story:llm-context-limit-test": "node tests/story-llm-context-limit.test.js",
    "story:dialogue-8b": "node tools/story-dialogue-8b-runner.js",
    "story:dialogue-8b-battery": "node tools/story-dialogue-8b-runner.js --battery --turns=540 --output=qa-runtime/story-dialogue-8b-battery-report.json",
    "story:dialogue-8b-s6-battery": "node tools/story-dialogue-8b-runner.js --battery --turns=540 --output=qa-runtime/story-dialogue-8b-s6-battery-report.json",
    "story:dialogue-8b-smoke": "node tools/story-dialogue-8b-runner.js --smoke",
    "story:dialogue-8b-negatives-test": "node tests/story-conversation-8b-negatives.test.js",
    "story:dialogue-8b-manifest": "node tools/story-dialogue-8b-manifest.js",
    "story:dialogue-8b-manifest-test": "node tests/story-dialogue-8b-manifest.test.js",
    "story:dialogue-8b-audit": "node tools/story-dialogue-8b-audit.js",
    "story:dialogue-adversarial-manifest": "node tools/story-dialogue-adversarial-player-manifest.js",
    "story:dialogue-adversarial-manifest-test": "node tests/story-dialogue-adversarial-player-manifest.test.js",
    "story:dialogue-adversarial-live": "node tools/story-dialogue-8b-runner.js --adversarial --turns=60 --output=qa-runtime/story-dialogue-adversarial-live.json",
    "story:dialogue-adversarial-14b-smoke": "node tools/story-dialogue-8b-runner.js --adversarial --player14b --swap-smoke --turns=1 --output=qa-runtime/story-dialogue-adversarial-14b-smoke.json",
    "story:dialogue-adversarial-14b-acceptance": "node tools/story-dialogue-8b-runner.js --adversarial --player14b --turns=6 --output=qa-runtime/story-dialogue-adversarial-14b-acceptance-6.json",
    "story:dialogue-frontier-smoke": "node tools/story-dialogue-frontier-runner.js --sessions=2 --depth=2 --player-microbatch=2 --output=qa-runtime/story-dialogue-frontier-smoke.json",
    "story:dialogue-frontier-micro-smoke": "node tools/story-dialogue-frontier-runner.js --sessions=2 --depth=1 --player-microbatch=2 --output=qa-runtime/story-dialogue-frontier-micro-smoke.json",
    "story:dialogue-frontier-acceptance": "node tools/story-dialogue-frontier-runner.js --sessions=4 --depth=2 --player-microbatch=2 --output=qa-runtime/story-dialogue-frontier-acceptance-8.json",
    "story:dialogue-frontier-domain-smoke": "node tools/story-dialogue-frontier-runner.js --sessions=2 --depth=1 --scenario-offset=6 --player-microbatch=2 --output=qa-runtime/story-dialogue-frontier-domain-smoke.json",
    "test:story-dialogue-frontier-state": "node tests/story-dialogue-frontier-state.test.js",
    "test:story-dialogue-llm-host-lifecycle": "node tests/story-dialogue-llm-host-lifecycle.test.js",
    "story:dialogue-frontier-night": "node tools/story-dialogue-frontier-runner.js --sessions=100 --depth=10 --player-microbatch=2 --output=qa-runtime/story-dialogue-frontier-night-1000.json",
    "story:build-map-raster": "node tools/make-story-map-raster.js",
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "shortcut": "node electron/make-shortcut.js",
    "icon": "node tools/make-icon.js",
    "test:online": "node tools/online-lockstep-kapi.js"
  },
  "dependencies": {
    "node-llama-cpp": "^3.19.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.pixelrts.game",
    "productName": "Pixel RTS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "js/**/*",
      "assets/**/*",
      "icons.png",
      "index.html",
      "style.css",
      "!**/*.md",
      "!__pycache__/**",
      "!dist/**",
      "!tools/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*.gguf",
          "**/NOTICE.txt",
          "**/*LICENSE*.txt"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/node-llama-cpp/bins/**",
      "**/node_modules/node-llama-cpp/llama/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pixel RTS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Pixel-RTS-Kurulum-${version}.${ext}"
    }
  }
}
