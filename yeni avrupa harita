(async function(){
  const topo = await (await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-110m.json')).json();
  const obj = topo.objects.countries;
  const features = topojson.feature(topo, obj).features;
  const world = {
    features,
    land: topojson.merge(topo, obj.geometries),
    frontMesh: topojson.mesh(topo, obj, (a,b)=>a!==b && blocOf(a)!==blocOf(b)),
    innerMesh: topojson.mesh(topo, obj, (a,b)=>a!==b && blocOf(a)===blocOf(b)),
    coastMesh: topojson.mesh(topo, obj, (a,b)=>a===b)
  };
  for(const scr of document.querySelectorAll('.screen')){
    const opt = scr.dataset.opt, cfg = CFG[opt];
    scr.innerHTML = frameHTML(opt);
    renderMap(scr.querySelector('.mapcv'), cfg, BBOX, 'far', world);
    renderMap(scr.querySelector('.insetcv'), cfg, INSET_BBOX, 'near', world);
  }
})();
