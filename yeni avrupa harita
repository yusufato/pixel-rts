function bboxPoly(b){ return {type:'MultiPoint',coordinates:[[b[0][0],b[0][1]],[b[1][0],b[0][1]],[b[1][0],b[1][1]],[b[0][0],b[1][1]]]}; }

function renderMap(cv, cfg, bbox, lod, world){
  const {features, land, frontMesh, innerMesh, coastMesh} = world;
  const w=cv.width, h=cv.height, ctx=cv.getContext('2d');
  const proj=d3.geoMercator().fitSize([w,h], bboxPoly(bbox));
  const path=d3.geoPath(proj, ctx);
  const P=(lon,lat)=>proj([lon,lat]);
  const pxDeg = Math.abs(P(11,48)[0]-P(10,48)[0]);   // 1 derece ≈ px
  // deniz
  const sg=ctx.createLinearGradient(0,0,0,h);
  sg.addColorStop(0,cfg.sea[0]); sg.addColorStop(.55,cfg.sea[1]); sg.addColorStop(1,cfg.sea[2]);
  ctx.fillStyle=sg; ctx.fillRect(0,0,w,h);
  // kara ekstrüzyonu (2.5D)
  const depth=lod==='near'?Math.round(cfg.extr*.6):cfg.extr;
  ctx.fillStyle=cfg.extrCol;
  for(let d=depth;d>=1;d--){ ctx.save(); ctx.translate(0,d); ctx.beginPath(); path(land); ctx.fill(); ctx.restore(); }
  // arazi tabanı (enlem gradyanı) — kara clip
  ctx.save(); ctx.beginPath(); path(land); ctx.clip();
  const yTop=P(0,bbox[1][1])[1], yBot=P(0,bbox[0][1])[1];
  const lg=ctx.createLinearGradient(0,yTop,0,yBot);
  const rgb=a=>`rgb(${a[0]},${a[1]},${a[2]})`;
  lg.addColorStop(0,rgb(cfg.landN)); lg.addColorStop(.5,rgb(cfg.landM)); lg.addColorStop(1,rgb(cfg.landS));
  ctx.fillStyle=lg; ctx.fillRect(0,0,w,h);
  // çöl kuşağı (lat<35 → lat 28 tam)
  const y35=P(0,35)[1], y28=P(0,28)[1];
  if(y35<h){ const dg=ctx.createLinearGradient(0,y35,0,y28);
    dg.addColorStop(0,'rgba(196,168,110,0)'); dg.addColorStop(1,'rgba(206,178,116,.9)');
    ctx.fillStyle=dg; ctx.fillRect(0,y35,w,h-y35); }
  // boreal orman (lat>57)
  const y57=P(0,57)[1], y63=P(0,63)[1];
  if(y57>0){ const fg=ctx.createLinearGradient(0,y57,0,y63);
    fg.addColorStop(0,'rgba(30,64,40,0)'); fg.addColorStop(1,'rgba(24,54,36,.7)');
    ctx.fillStyle=fg; ctx.fillRect(0,0,w,y57+2); }
  // orta Anadolu / İspanya iç steppe hafif ton
  for(const [lon,lat,r] of [[33,39,2.6],[-4.3,40.5,2.2],[44,31,4]]){
    const p=P(lon,lat), rr=r*pxDeg, g2=ctx.createRadialGradient(p[0],p[1],0,p[0],p[1],rr);
    g2.addColorStop(0,'rgba(190,168,108,.4)'); g2.addColorStop(1,'rgba(190,168,108,0)');
    ctx.fillStyle=g2; ctx.fillRect(p[0]-rr,p[1]-rr,rr*2,rr*2);
  }
  // dağ sıraları — hillshade
  for(const [pts,r,str] of RANGES){
    const rr=r*pxDeg;
    for(let i=0;i<pts.length;i++){
      const segs = i<pts.length-1?3:1;
      for(let s=0;s<segs;s++){
        const t=s/segs, a=pts[i], b=pts[Math.min(i+1,pts.length-1)];
        const p=P(a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t);
        let g2=ctx.createRadialGradient(p[0],p[1],0,p[0],p[1],rr);
        const mt=cfg.mtnTone;
        g2.addColorStop(0,`rgba(${mt[0]},${mt[1]},${mt[2]},${.85*str})`); g2.addColorStop(1,`rgba(${mt[0]},${mt[1]},${mt[2]},0)`);
        ctx.fillStyle=g2; ctx.fillRect(p[0]-rr,p[1]-rr,rr*2,rr*2);
        g2=ctx.createRadialGradient(p[0]+rr*.25,p[1]+rr*.25,0,p[0]+rr*.25,p[1]+rr*.25,rr*.9);
        g2.addColorStop(0,cfg.mtnSh.replace(/[\d.]+\)$/,(m)=> (parseFloat(m)*str)+')')); g2.addColorStop(1,'rgba(0,0,0,0)');
        ctx.fillStyle=g2; ctx.fillRect(p[0]-rr,p[1]-rr,rr*2.5,rr*2.5);
        g2=ctx.createRadialGradient(p[0]-rr*.28,p[1]-rr*.28,0,p[0]-rr*.28,p[1]-rr*.28,rr*.55);
        g2.addColorStop(0,cfg.mtnHi); g2.addColorStop(1,'rgba(255,255,255,0)');
        ctx.fillStyle=g2; ctx.fillRect(p[0]-rr*2,p[1]-rr*2,rr*3,rr*3);
      }
    }
  }
  // pixel doku
  const rnd=(sx=>()=> (sx=(sx*1103515245+12345)&0x7fffffff)/0x7fffffff)(7);
  ctx.fillStyle='rgba(0,0,0,.05)';
  for(let i=0;i<2600;i++){ ctx.fillRect(rnd()*w, rnd()*h, 2,2); }
  ctx.fillStyle='rgba(255,255,255,.035)';
  for(let i=0;i<1600;i++){ ctx.fillRect(rnd()*w, rnd()*h, 2,2); }
  // politik boyama
  for(const f of features){
    const b=blocOf(f);
    ctx.beginPath(); path(f);
    if(b){ ctx.fillStyle=BLOC[b].c; ctx.globalAlpha=cfg.tint; ctx.fill(); }
    else { ctx.fillStyle='#777'; ctx.globalAlpha=cfg.tint*.25; ctx.fill(); }
    ctx.globalAlpha=1;
  }
  ctx.restore();
  // nehirler
  ctx.strokeStyle=cfg.river; ctx.lineWidth=lod==='near'?2:1.3; ctx.lineCap='round'; ctx.lineJoin='round';
  for(const rv of RIVERS){ ctx.beginPath(); rv.forEach((pt,i)=>{ const p=P(pt[0],pt[1]); i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]); }); ctx.stroke(); }
  // iç sınırlar (aynı blok) + kıyı
  ctx.beginPath(); path(innerMesh); ctx.strokeStyle=cfg.borderIn; ctx.lineWidth=1; ctx.stroke();
  ctx.beginPath(); path(coastMesh); ctx.strokeStyle=cfg.coast; ctx.lineWidth=1.2; ctx.stroke();
  // CEPHE HATLARI (farklı blok sınırı)
  ctx.beginPath(); path(frontMesh);
  ctx.save(); ctx.strokeStyle=cfg.front; ctx.lineWidth=cfg.frontW; ctx.setLineDash([7,4]);
  ctx.shadowColor=cfg.front; ctx.shadowBlur=6; ctx.stroke(); ctx.restore();
  // yollar
  const roadA = lod==='near'?1:.55;
  ctx.save(); ctx.globalAlpha=roadA; ctx.strokeStyle=cfg.road; ctx.lineWidth=cfg.roadW; ctx.setLineDash(cfg.marker==='pillar'?[5,3]:[]);
  for(const [a,b] of ROADS){
    const A=CITIES[CI[a]], B=CITIES[CI[b]]; const p=P(A[1],A[2]), q=P(B[1],B[2]);
    const mx=(p[0]+q[0])/2, my=(p[1]+q[1])/2 - Math.hypot(q[0]-p[0],q[1]-p[1])*.08;
    ctx.beginPath(); ctx.moveTo(p[0],p[1]); ctx.quadraticCurveTo(mx,my,q[0],q[1]); ctx.stroke();
  }
  ctx.restore();
  // şehirler
  ctx.textAlign='center';
  for(const [name,lon,lat,tier,fac,oil] of CITIES){
    const p=P(lon,lat); if(p[0]<-20||p[1]<-20||p[0]>w+20||p[1]>h+20) continue;
    if(lod!=='near' && tier<2) continue;
    const x=Math.round(p[0]), y=Math.round(p[1]);
    const col = '#ffffff';
    if(cfg.marker==='pixel'){
      const s=tier===3?6:tier===2?4.5:3;
      ctx.fillStyle='#000'; ctx.fillRect(x-s-1,y-s-1,2*s+2,2*s+2);
      ctx.fillStyle=tier===3?'#ffe9bf':col; ctx.fillRect(x-s,y-s,2*s,2*s);
      if(tier===3){ ctx.strokeStyle='#ffb000'; ctx.lineWidth=1.5; ctx.strokeRect(x-s-3,y-s-3,2*s+6,2*s+6); }
    } else if(cfg.marker==='dot'){
      const r=tier===3?6:tier===2?4.5:3;
      ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fillStyle='#20180a'; ctx.fill();
      ctx.lineWidth=1.6; ctx.strokeStyle='#fffbe8'; ctx.stroke();
      if(tier===3){ ctx.beginPath(); ctx.arc(x,y,r+3.4,0,7); ctx.strokeStyle='#20180a'; ctx.lineWidth=1.2; ctx.stroke(); }
    } else { // pillar
      const ph=6+tier*8;
      ctx.save(); ctx.strokeStyle='rgba(255,176,0,.9)'; ctx.shadowColor='#ffb000'; ctx.shadowBlur=8; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x,y-ph); ctx.stroke();
      ctx.fillStyle=tier===3?'#ffe9bf':'#ffb000'; ctx.fillRect(x-3,y-ph-3,6,6);
      ctx.restore();
      ctx.beginPath(); ctx.ellipse(x,y,5,2.2,0,0,7); ctx.strokeStyle='rgba(255,176,0,.5)'; ctx.lineWidth=1; ctx.stroke();
    }
    // fabrika (seviye = baca sayısı)
    if(fac>0 && (lod==='near'||tier===3)){
      const fx=x+9, fy=(cfg.marker==='pillar'? y-4 : y-4);
      ctx.fillStyle='rgba(0,0,0,.65)'; ctx.fillRect(fx-1,fy-6,10,8);
      ctx.fillStyle=cfg.marker==='dot'?'#4a4034':'#c8b070'; ctx.fillRect(fx,fy-5,8,6);
      for(let k=0;k<Math.min(fac,3);k++){ ctx.fillRect(fx+1+k*3,fy-9,2,4); ctx.fillStyle='#ffb000'; ctx.fillRect(fx+1+k*3,fy-10,2,1); ctx.fillStyle=cfg.marker==='dot'?'#4a4034':'#c8b070'; }
    }
    // petrol
    if(oil && (lod==='near'||tier>=2)){
      const ox=x-12, oy=y-2;
      ctx.strokeStyle='#ff8a00'; ctx.lineWidth=1.4;
      ctx.beginPath(); ctx.moveTo(ox-4,oy+4); ctx.lineTo(ox,oy-6); ctx.lineTo(ox+4,oy+4); ctx.stroke();
      ctx.fillStyle='#ff8a00'; ctx.fillRect(ox-1.5,oy-7,3,3);
    }
    // etiket
    if(lod==='near' || tier>=2){
      const fs=tier===3?11:lod==='near'?10:9;
      ctx.font=(tier===3?'bold ':'')+fs+'px "Share Tech Mono"';
      ctx.lineWidth=3; ctx.strokeStyle=cfg.halo;
      const ly=cfg.marker==='pillar'? y-(6+tier*8)-7 : y-(tier===3?12:9);
      ctx.strokeText(name.toUpperCase(),x,ly); ctx.fillStyle=cfg.label; ctx.fillText(name.toUpperCase(),x,ly);
    }
  }
  // seçili şehir vurgusu (Ankara)
  const ap=P(32.85,39.93), ax=Math.round(ap[0]), ay=Math.round(ap[1]);
  ctx.strokeStyle='#ffb000'; ctx.lineWidth=2; ctx.strokeRect(ax-13,ay-13,26,26);
  ctx.font='9px "Share Tech Mono"'; ctx.lineWidth=3; ctx.strokeStyle=cfg.halo;
  ctx.strokeText('SELECT',ax,ay+24); ctx.fillStyle='#ffb000'; ctx.fillText('SELECT',ax,ay+24);
  ctx.fillStyle='#060a06'; ctx.fillRect(ax-11,ay+2,22,10);
  ctx.fillStyle='#ffd27a'; ctx.font='bold 8px "Share Tech Mono"'; ctx.fillText('CMD',ax,ay+10);
  // War Room renk kapama
  if(cfg.desat){ ctx.fillStyle=cfg.desat; ctx.fillRect(0,0,w,h); }
}

